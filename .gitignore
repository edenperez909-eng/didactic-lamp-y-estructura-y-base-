gitignore# =========================================================================
# 📦 DEPENDENCIES & PACKAGES
# =========================================================================
node_modules/
jspm_packages/
web_modules/
bower_components/
.pnpm-store/
.yarn-integrity/
.npm/

# Yarn v3 Core
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# =========================================================================
# ⚙️ BUILDS, OUTPUTS & FRAMEWORKS
# =========================================================================
# Next.js
.next/
out/

# Nuxt.js
.nuxt/
dist/
.output/

# SvelteKit & Gatsby & Docusaurus
.svelte-kit/
.cache/
.docusaurus/

# VuePress & VitePress
.vuepress/dist/
.temp/
**/.vitepress/dist/
**/.vitepress/cache/

# General Builds & Binary Addons
build/Release/
.serverless/
.fusebox/

# Monorepo tools (Turbo / Nx)
.turbo/
.nx/

# =========================================================================
# 🔧 CACHES, TIMESTAMPS & TOOLS
# =========================================================================
# Vite Caches
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# Linters & Compilers Caches
*.tsbuildinfo
.eslintcache
.stylelintcache
.parcel-cache
.lock-wscript
.grunt/

# =========================================================================
# 🔒 SECRETS & ENVIRONMENT VARIABLES
# =========================================================================
.env
.env.*
!.env.example

# =========================================================================
# 🧪 TESTING, COVERAGE & LOGS
# =========================================================================
# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Coverage
lib-cov/
coverage/
*.lcov
.nyc_output/

# Reports & Runtime Data
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
pids/
*.pid
*.seed
*.pid.lock

# =========================================================================
# 🖥️ EDITORS, IDEs & SYSTEM FILES (¡NUEVO!)
# =========================================================================
# VS Code (Ignora configuraciones locales del usuario, pero mantiene las recomendadas si existen)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# IntelliJ / WebStorm / Android Studio
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS X / macOS System Files
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows System Files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# =========================================================================
# 🗄️ LOCAL DATABASES & EXTRA TOOLS (¡NUEVO!)
# =========================================================================
.dynamodb/
.firebase/
.tern-port
.vscode-test/
.node_repl_history
*.tgz

# Local SQLite databases & Prisma
*.db
*.db-journal
/prisma/db/

# Optional Docker local files
.docker/